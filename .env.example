# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth (NextAuth) ------------------------------------------------------
# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Participant GitHub OAuth --------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_API_TOKEN=""

# Protects Vercel Cron routes. Configure the same value in Vercel Cron and env.
CRON_SECRET=""

# Comma-separated repositories scanned by the daily GitHub sync.
GITHUB_REPOSITORIES="https://github.com/example/codesprint"
GITHUB_SYNC_CHECKPOINT_ORDER="1"
GITHUB_SPRINT_START_ISO="2026-01-01T00:00:00Z"

# --- App ------------------------------------------------------------------
# Slug of the currently active event, used to scope the public leaderboard.
NEXT_PUBLIC_ACTIVE_EVENT_SLUG="codesprint-2026"

# ISO 8601 start date/time for the homepage countdown (placeholder until confirmed).
NEXT_PUBLIC_EVENT_START_DATE="2026-09-12T09:00:00+05:30"
